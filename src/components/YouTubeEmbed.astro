---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** YouTube video id, e.g. "Qt1-PqSqAcU". */
  id: string;
  title: string;
  /** Poster image, stored locally so no request goes to YouTube before the visitor presses play. */
  poster: ImageMetadata;
  /** Larger variant for the lead video. */
  featured?: boolean;
}

const { id, title, poster, featured = false } = Astro.props;
---

<figure class="yt rise" data-yt={id} data-title={title}>
  <a href={`https://www.youtube.com/watch?v=${id}`} class="yt-frame" target="_blank" rel="noopener">
    <Image
      src={poster}
      alt=""
      widths={featured ? [640, 960, 1280] : [480, 640, 960]}
      sizes={featured ? '(min-width: 1152px) 72rem, 100vw' : '(min-width: 1152px) 35rem, (min-width: 640px) 45vw, 100vw'}
      loading={featured ? 'eager' : 'lazy'}
      class="yt-poster"
    />
    <span class="yt-shade" aria-hidden="true"></span>
    <span class="yt-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" fill="currentColor"></path></svg>
    </span>
    <span class="sr-only">Video afspelen: {title} (YouTube)</span>
  </a>
  <figcaption>
    <span class="yt-title">{title}</span>
  </figcaption>
</figure>

<style>
  .yt {
    margin: 0;
  }
  .yt-frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 1.75rem;
    background: var(--color-ink);
    box-shadow: var(--shadow-card);
    isolation: isolate;
    transition:
      box-shadow 0.5s var(--ease-smooth),
      transform 0.5s var(--ease-smooth);
  }
  .yt-frame:hover {
    box-shadow: var(--shadow-lift);
    transform: translateY(-4px);
  }
  .yt-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-smooth);
  }
  .yt-frame:hover .yt-poster {
    transform: scale(1.05);
  }
  .yt-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(43 58 74 / 0.55), transparent 55%);
  }
  .yt-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 4.75rem;
    height: 4.75rem;
    margin: -2.375rem 0 0 -2.375rem;
    padding-left: 0.2rem;
    border-radius: 999px;
    background: var(--color-clay);
    color: #fff;
    box-shadow:
      0 0 0 0.6rem rgb(255 255 255 / 0.28),
      0 14px 30px -8px rgb(0 0 0 / 0.5);
    transition:
      transform 0.4s var(--ease-smooth),
      background-color 0.3s;
  }
  .yt-frame:hover .yt-play {
    transform: scale(1.1);
    background: var(--color-clay-dark);
  }
  figcaption {
    margin-top: 0.9rem;
    padding-inline: 0.25rem;
  }
  .yt-title {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .yt-frame.is-playing {
    transform: none;
  }
  .yt-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    animation: yt-in 0.5s var(--ease-smooth) both;
  }
  @keyframes yt-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .yt-frame,
    .yt-poster,
    .yt-play,
    .yt-frame iframe {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  // Pas bij een klik wordt de echte YouTube-speler (nocookie) geladen; zonder JS opent de link YouTube zelf.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('.yt-frame');
    if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
    const fig = link.closest<HTMLElement>('[data-yt]')!;
    e.preventDefault();
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${fig.dataset.yt}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
    iframe.title = fig.dataset.title ?? 'YouTube-video';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    link.replaceChildren(iframe);
    link.classList.add('is-playing');
    link.removeAttribute('href');
    iframe.focus();
  });
</script>
