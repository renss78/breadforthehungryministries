---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { getNav } from '../data/site';
import { getLang, route, switchPath, ui, langs } from '../i18n';

const path = Astro.url.pathname;
const lang = getLang(Astro.url);
const t = ui[lang];
const nav = getNav(lang);
const homeHref = route('home', lang);
const isActive = (href: string) => href !== '#' && (path === href || (href !== homeHref && path.startsWith(href)));
const languages = langs.map((l) => ({ lang: l, short: l.toUpperCase(), name: l === 'nl' ? 'Nederlands' : 'English', href: switchPath(path, l), current: l === lang }));
---

<header class="site-header sticky top-0 z-50 bg-cream/75 backdrop-blur-xl backdrop-saturate-150">
  <div class="container-page flex items-center justify-between gap-4 py-4">
    <a href={homeHref} class="shrink-0" aria-label={t.homeLabel}>
      <Image src={logo} alt="" width={228} height={76} loading="eager" class="h-11 w-auto sm:h-[3.75rem]" />
    </a>

    <nav aria-label={t.mainMenu} class="hidden xl:block">
      <ul class="flex items-center gap-1">
        <li>
          <a href={homeHref} class="nav-link home-link" aria-current={path === homeHref ? 'page' : undefined}>
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V20h5v-5.5h4V20h5V9.5"></path></svg>
            {t.home}
          </a>
        </li>
        {
          nav.map((item) => (
            <li class="relative" data-dropdown={item.children ? '' : undefined}>
              {item.children ? (
                <>
                  <button
                    type="button"
                    class="nav-link inline-flex items-center gap-1.5"
                    aria-expanded="false"
                    aria-haspopup="true"
                    data-active={item.children.some((c) => isActive(c.href)) || undefined}
                  >
                    {item.label}
                    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                      <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                  <ul class="dropdown" hidden>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a href={item.href} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <ul class="lang-switch hidden sm:flex" aria-label={t.language}>
        {
          languages.map((l) => (
            <li>
              <a href={l.href} lang={l.lang} hreflang={l.lang} aria-label={l.name} aria-current={l.current ? 'true' : undefined}>
                {l.short}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={route('sponsorship', lang)} class="btn btn-clay whitespace-nowrap !px-5 !py-2.5 text-base sm:!px-6 sm:!py-3 sm:text-[1.05rem]">{t.support}</a>
      <button type="button" class="menu-toggle xl:hidden" aria-expanded="false" aria-controls="mobiel-menu" aria-label={t.menu} data-label-open={t.menu} data-label-close={t.menuClose}>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" class="icon-open">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"></path>
        </svg>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" class="icon-close">
          <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobiel-menu" aria-label={t.mobileMenu} class="mobile-panel xl:hidden" hidden>
    <ul class="container-page py-4">
      <li>
        <a href={homeHref} class="m-link m-home" aria-current={path === homeHref ? 'page' : undefined}>
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V20h5v-5.5h4V20h5V9.5"></path></svg>
          {t.home}
        </a>
      </li>
      {
        nav.map((item) =>
          item.children ? (
            <li>
              <p class="m-group">{item.label}</p>
              <ul>
                {item.children.map((c) => (
                  <li>
                    <a href={c.href} class="m-link m-sub" aria-current={isActive(c.href) ? 'page' : undefined}>
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={item.href} class="m-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ),
        )
      }
      <li class="m-lang">
        <p class="m-group">{t.language}</p>
        <ul class="flex gap-2">
          {
            languages.map((l) => (
              <li>
                <a href={l.href} lang={l.lang} hreflang={l.lang} class="m-lang-link" aria-current={l.current ? 'true' : undefined}>
                  {l.name}
                </a>
              </li>
            ))
          }
        </ul>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    view-transition-name: site-header;
    border-bottom: 1px solid rgb(43 58 74 / 0.06);
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .site-header {
        animation: header-shadow linear both;
        animation-timeline: scroll(root);
        animation-range: 0 120px;
      }
      @keyframes header-shadow {
        to {
          box-shadow: 0 10px 30px -14px rgb(60 45 25 / 0.28);
          background-color: rgb(251 246 236 / 0.9);
        }
      }
    }
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    padding: 0.65rem 1.05rem;
    border-radius: 999px;
    font-size: 1.075rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      background-color 0.3s var(--ease-smooth),
      color 0.3s var(--ease-smooth);
  }
  .nav-link:hover,
  .nav-link[aria-expanded='true'] {
    background: var(--color-sand);
  }
  .nav-link[aria-current='page'],
  .nav-link[data-active] {
    color: var(--color-teal-700);
    box-shadow: inset 0 -2px 0 var(--color-gold-500);
    border-radius: 0;
  }
  .dropdown {
    position: absolute;
    left: 0;
    top: 100%;
    min-width: 13rem;
    padding: 0.5rem;
    margin-top: 0.1rem;
    background: #fff;
    border-radius: 1.4rem;
    box-shadow: var(--shadow-lift);
    border: 1px solid rgb(43 58 74 / 0.06);
    animation: pop 0.3s var(--ease-smooth);
  }
  .dropdown[hidden] {
    display: none;
  }
  .dropdown a {
    display: block;
    padding: 0.7rem 1rem;
    border-radius: 0.6rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink);
  }
  .dropdown a:hover {
    background: var(--color-cream);
    color: var(--color-teal-700);
  }
  .dropdown a[aria-current='page'] {
    color: var(--color-teal-700);
    background: var(--color-teal-100);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }
  .menu-toggle {
    display: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    color: var(--color-ink);
  }
  @media (max-width: 1279.98px) {
    .menu-toggle {
      display: inline-grid;
    }
  }
  .menu-toggle .icon-close,
  .menu-toggle[aria-expanded='true'] .icon-open {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }
  .menu-toggle:hover {
    background: var(--color-sand);
  }
  .mobile-panel {
    border-top: 1px solid rgb(43 58 74 / 0.1);
    background: var(--color-cream);
    max-height: calc(100dvh - 5.5rem);
    overflow-y: auto;
  }
  .mobile-panel[hidden] {
    display: none;
  }
  .m-link {
    display: block;
    padding: 0.7rem 0;
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  .m-link[aria-current='page'] {
    color: var(--color-teal-700);
  }
  .m-home {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .m-sub {
    padding-left: 1rem;
    font-weight: 500;
    border-left: 2px solid var(--color-gold-300);
  }
  .m-group {
    margin-top: 0.6rem;
    padding: 0.7rem 0 0.2rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  /* Ruimte voor de taalwisselaar naast het menu op schermen van 1280–1535 px. */
  @media (min-width: 1280px) and (max-width: 1535.98px) {
    .nav-link {
      padding-inline: 0.75rem;
    }
  }
  .lang-switch {
    align-items: center;
    gap: 0.15rem;
    padding: 0.2rem;
    border-radius: 999px;
    background: var(--color-sand);
  }
  .lang-switch a {
    display: block;
    min-width: 2.4rem;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-ink);
    text-decoration: none;
  }
  .lang-switch a:hover {
    background: #fff;
  }
  .lang-switch a[aria-current='true'] {
    background: var(--color-teal-700);
    color: #fff;
  }
  .m-lang {
    margin-top: 0.4rem;
    padding-bottom: 0.4rem;
  }
  .m-lang-link {
    display: block;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    background: var(--color-sand);
  }
  .m-lang-link[aria-current='true'] {
    background: var(--color-teal-700);
    color: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    .dropdown {
      animation: none;
    }
  }
</style>

<script>
  // Menu: dropdowns (desktop) and mobile panel. Everything else on the site works without JS.
  const header = document.querySelector('header')!;
  const dropdowns = [...header.querySelectorAll<HTMLElement>('[data-dropdown]')];
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const panel = header.querySelector<HTMLElement>('#mobiel-menu')!;

  const setDropdown = (li: HTMLElement, open: boolean) => {
    li.querySelector('button')!.setAttribute('aria-expanded', String(open));
    li.querySelector<HTMLElement>('.dropdown')!.hidden = !open;
  };
  const closeAll = (except?: HTMLElement) => dropdowns.forEach((li) => li !== except && setDropdown(li, false));

  const canHover = matchMedia('(hover: hover)').matches;
  dropdowns.forEach((li) => {
    const btn = li.querySelector('button')!;
    btn.addEventListener('click', () => {
      // On hover devices the dropdown is already open from mouseenter; a click must not close it again.
      const open = canHover && btn.matches(':hover') ? true : btn.getAttribute('aria-expanded') !== 'true';
      closeAll(li);
      setDropdown(li, open);
    });
    if (canHover) {
      li.addEventListener('mouseenter', () => {
        closeAll(li);
        setDropdown(li, true);
      });
      li.addEventListener('mouseleave', () => setDropdown(li, false));
    }
  });

  const setPanel = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? 'Menu');
    panel.hidden = !open;
  };
  toggle.addEventListener('click', () => setPanel(toggle.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-dropdown]')) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    closeAll();
    if (toggle.getAttribute('aria-expanded') === 'true') {
      setPanel(false);
      toggle.focus();
    }
  });
  matchMedia('(min-width: 1280px)').addEventListener('change', (e) => e.matches && setPanel(false));
</script>
