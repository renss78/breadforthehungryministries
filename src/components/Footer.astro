---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { site, getNav } from '../data/site';
import { getLang, route, ui } from '../i18n';
import Wave from './Wave.astro';

const lang = getLang(Astro.url);
const t = ui[lang];
const nav = getNav(lang);
const year = new Date().getFullYear();
---

<footer class="relative bg-ink text-white/85">
  <Wave class="absolute inset-x-0 bottom-full -mb-px text-ink" />
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div>
      <a href={route('home', lang)} aria-label={t.homeLabelFooter} class="inline-block rounded-xl bg-cream p-3">
        <Image src={logo} alt="Bread for the Hungry" width={150} height={50} class="h-10 w-auto" loading="lazy" />
      </a>
      <p class="mt-5 max-w-xs text-[0.95rem]">{t.tagline}</p>
    </div>

    <nav aria-label={t.footerMenu}>
      <h2 class="text-sm font-bold uppercase tracking-[0.14em] !text-gold-300 !font-sans">{t.navigation}</h2>
      <ul class="mt-4 space-y-2">
        <li><a href={route('home', lang)} class="foot-link">{t.home}</a></li>
        {nav.flatMap((i) => i.children ?? [i]).map((i) => <li><a href={i.href} class="foot-link">{i.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.14em] !text-gold-300 !font-sans">{t.contact}</h2>
      <ul class="mt-4 space-y-2">
        <li><a href={`mailto:${site.email}`} class="foot-link break-all">{site.email}</a></li>
        <li><a href={`tel:${site.phone}`} class="foot-link">{site.phone}</a></li>
      </ul>
      <a href={route('sponsorship', lang)} class="btn btn-clay mt-6">{t.support}</a>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.14em] !text-gold-300 !font-sans">{t.anbi}</h2>
      <dl class="mt-4 space-y-1 text-[0.95rem]">
        <div class="flex gap-2"><dt class="text-white/70">KvK</dt><dd>{site.kvk}</dd></div>
        <div class="flex gap-2"><dt class="text-white/70">RSIN</dt><dd>{site.rsin}</dd></div>
        <div class="flex gap-2"><dt class="text-white/70">IBAN</dt><dd>{site.iban}</dd></div>
      </dl>
      <a href={route('anbi', lang)} class="foot-link mt-3 inline-block">{t.anbiProfile}</a>
    </div>
  </div>
  <div class="border-t border-white/15">
    <p class="container-page py-5 text-sm text-white/70">© {year} {site.name}. {t.rights}</p>
  </div>
</footer>

<style>
  .foot-link {
    color: rgb(255 255 255 / 0.9);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .foot-link:hover {
    color: #fff;
    border-bottom-color: var(--color-gold-300);
  }
</style>
