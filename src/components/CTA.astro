---
import { Image } from 'astro:assets';
import Wave from './Wave.astro';
import { getLang, route, ui } from '../i18n';
import img1 from '../assets/images/2025-09-5.png';
import img2 from '../assets/images/2025-09-6.png';
import img3 from '../assets/images/2025-09-2.png';
import img4 from '../assets/images/2025-09-3.png';

interface Props {
  /** Show the little photo strip (home and sponsoring use it, inner pages stay calm). */
  photos?: boolean;
}
const { photos = true } = Astro.props;
const lang = getLang(Astro.url);
const t = ui[lang];
const strip = [img1, img2, img3, img4];
---

<section class="relative bg-teal-700 text-white" aria-labelledby="cta-titel">
  <Wave class="absolute inset-x-0 bottom-full -mb-px text-teal-700" flip />
  <div class="container-page section grid items-center gap-10 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <h2 id="cta-titel" class="!text-white">{t.ctaTitle}</h2>
      <p class="mt-5 max-w-xl text-lg text-white/95">{t.ctaText}</p>
      <a href={route('sponsorship', lang)} class="btn btn-clay mt-8 !bg-gold-300 !text-ink hover:!bg-white">{t.ctaButton}</a>
    </div>
    {
      photos && (
        <ul class="grid grid-cols-2 gap-3" aria-hidden="true">
          {strip.map((src, i) => (
            <li class:list={['rise overflow-hidden rounded-[1.75rem] shadow-lift', i % 2 ? 'translate-y-5' : '']}>
              <Image src={src} alt="" widths={[240, 400]} sizes="(min-width: 1024px) 20vw, 45vw" class="aspect-[4/3] w-full object-cover" loading="lazy" />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
