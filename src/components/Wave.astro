---
interface Props {
  /** Tailwind text-color class that sets the fill, e.g. "text-cream". */
  class?: string;
  /** Mirror the wave horizontally for a less repetitive rhythm. */
  flip?: boolean;
}
const { class: className = '', flip = false } = Astro.props;
---

<svg
  class:list={['wave pointer-events-none block h-7 w-full sm:h-12 lg:h-16', flip && '-scale-x-100', className]}
  viewBox="0 0 1440 80"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path fill="currentColor" d="M0 44C180 92 360 8 600 30s420 70 640 34c80-13 150-30 200-44V80H0Z"></path>
</svg>
