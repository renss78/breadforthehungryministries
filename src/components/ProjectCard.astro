---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  href: string;
  image: ImageMetadata;
  imageAlt?: string;
  position?: string;
}

const { title, href, image, imageAlt = '', position = '50% 50%' } = Astro.props;
---

<article class="group relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rise rounded-[2rem] bg-ink text-white shadow-card transition-shadow duration-500 hover:shadow-lift sm:min-h-[30rem]">
  <Image
    src={image}
    alt={imageAlt}
    widths={[480, 768, 1000]}
    sizes="(min-width: 1024px) 40vw, 100vw"
    loading="lazy"
    class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-[1.06] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
    style={`object-position:${position}`}
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/70 to-transparent"></div>
  <div class="p-6 sm:p-9">
    <h3 class="!text-white sm:text-4xl">{title}</h3>
    <div class="mt-3 line-clamp-4 text-white/90"><slot /></div>
    <a href={href} class="btn btn-light mt-6 after:absolute after:inset-0">Lees verder<span class="sr-only"> over {title}</span> →</a>
  </div>
</article>
