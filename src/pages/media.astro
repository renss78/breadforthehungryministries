---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import { getLang, pick } from '../i18n';

const all = import.meta.glob<{ default: ImageMetadata }>('../assets/images/*.{png,jpg,jpeg,webp}', { eager: true });
const img = (name: string) => all[`../assets/images/${name}`].default;

const oegandaPhotos = ['2025-10-5.png', '2025-10-4.png', '2025-10-3.png', '2025-10-2.png', '2025-10-1.png', '2025-09-6.png', '2025-09-5.png', '2025-09-1748360707052_il570xn.2325703937j008.webp', '2025-09-4.png', '2025-09-3.png', '2025-09-2.png', '2025-09-1.png'];
const keniaPhotos = ['2025-10-5.png', '2025-10-4.png', '2025-10-3.png', '2025-10-2.png', '2025-10-1.png', '2025-09-6.png', '2025-09-5.png', '2025-09-1748360707052_il570xn.2325703937j008.webp'];
const oegandaVideos = ['WhatsApp-Video-2026-01-14-at-22.54.34.mp4', 'WhatsApp-Video-2026-01-14-at-22.53.39.mp4'];
const keniaVideos = ['WhatsApp-Video-2025-11-09-at-15.24.2891.mp4', 'WhatsApp-Video-2025-11-09-at-15.24.28.mp4', 'WhatsApp-Video-2025-11-09-at-15.24.29.mp4', 'WhatsApp-Video-2025-11-09-at-15.24.27.mp4'];

const lang = getLang(Astro.url);
const l = pick(lang);

const withFull = async (names: string[]) =>
  Promise.all(names.map(async (n) => ({ src: img(n), full: (await getImage({ src: img(n), width: 1600 })).src })));
const sections = [
  { id: 'fotos-oeganda', title: l("Foto's Oeganda", 'Photos of Uganda'), photos: await withFull(oegandaPhotos) },
  { id: 'videos-oeganda', title: l("Video's Oeganda", 'Videos of Uganda'), videos: oegandaVideos },
  { id: 'fotos-kenia', title: l("Foto's Kenia", 'Photos of Kenya'), photos: await withFull(keniaPhotos) },
  { id: 'videos-kenia', title: l("Video's Kenia", 'Videos of Kenya'), videos: keniaVideos },
];
const hero = img('2025-09-1.png');
---

<Layout
  title="Media"
  seoTitle={l("Foto's en video's uit Oeganda en Kenia | Bread for the Hungry", 'Photos and videos from Uganda and Kenya | Bread for the Hungry')}
  description={l(
    "Foto's en video's van het zendingswerk in Oeganda en Kenia: bijbelschool, diploma-uitreiking, waterputten en gemeenten.",
    'Photos and videos of the mission work in Uganda and Kenya: Bible school, graduation, water wells and churches.',
  )}
  image={hero}
>
  <Hero title="Media" eyebrow={l("Foto's en video's", 'Photos and videos')} image={hero} imageAlt={l("Studenten in toga's tijdens een diploma-uitreiking", 'Students in gowns during a graduation ceremony')} position="50% 40%" />

  <div class="container-page section space-y-20">
    {
      sections.map((s) => (
        <section aria-labelledby={s.id}>
          <h2 id={s.id}>{s.title}</h2>
          {s.photos && (
            <ul data-gallery class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
              {s.photos.map((p) => (
                <li>
                  <a href={p.full} class="rise group block overflow-hidden rounded-2xl bg-sand shadow-card">
                    <Image src={p.src} alt="" widths={[240, 360, 480]} sizes="(min-width: 1024px) 17rem, (min-width: 640px) 30vw, 45vw" class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none" loading="lazy" />
                    <span class="sr-only">{l('Foto vergroten', 'Enlarge photo')}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          {s.videos && (
            <ul class="mt-8 grid gap-4 sm:grid-cols-2">
              {s.videos.map((v) => (
                <li>
                  <video controls preload="metadata" playsinline class="rise aspect-video w-full rounded-2xl bg-ink shadow-card" src={`/media/video/${v}`} />
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>
  <CTA photos={false} />
</Layout>
