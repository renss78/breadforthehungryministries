---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import { getLang, pick } from '../i18n';
import hero from '../assets/images/2025-09-5.png';

const lang = getLang(Astro.url);
const l = pick(lang);

const algemeen: [string, string][] = [
  [l('Rechtsvorm', 'Legal form'), l('Stichting', 'Foundation (stichting)')],
  [l('Statutaire naam', 'Statutory name'), 'Stichting Bread for the Hungry Ministries'],
  [l('Statutaire zetel', 'Registered office'), 'Zwijndrecht'],
  [l('Land', 'Country'), l('Nederland', 'The Netherlands')],
  [l('KvK nummer', 'Chamber of Commerce (KvK) number'), '68179901'],
  ['RSIN', '857334591'],
  [l('Eerste inschrijving handelsregister', 'First registration in the trade register'), '28-02-2017'],
  [l('Datum akte van oprichting', 'Date of deed of incorporation'), '24-02-2017'],
];
const activiteiten: [string, string][] = [
  [l('Activiteiten', 'Activities'), l('Die stichting met name gericht op het ondersteunen van NGO’s (non-gouvernementele organisatie) in Kenia en Oeganda.', 'The foundation is mainly aimed at supporting NGOs (non-governmental organisations) in Kenya and Uganda.')],
  [l('Duidelijke beschrijving van doelstellingen', 'Clear description of objectives'), l('De stichting heeft als doel: een bron van inspiratie te zijn op het gebied van geestelijke en praktische ondersteuning aan mensen in de armste regionen in deze wereld en het verrichten van al wat hiermee verband houdt of daartoe bevorderlijk kan zijn.', 'The foundation’s objective is to be a source of inspiration in the field of spiritual and practical support to people in the poorest regions of the world, and to do everything connected with this or conducive to it.')],
  [l('Subcategorie I', 'Subcategory I'), l('Godsdienstig', 'Religious')],
  [l('Subcategorie II', 'Subcategory II'), l('Ontwikkelingswerk', 'Development work')],
  [l('Subcategorie III', 'Subcategory III'), l('Volksgezondheid', 'Public health')],
];
const organisatie: [string, string][] = [
  [l('Is er een directie / dagelijks bestuur', 'Is there an executive board / day-to-day management'), l('Nee', 'No')],
  [l('Is er een persoon in dienst?', 'Is anyone employed?'), l('Nee', 'No')],
  [l('Is er een raad van commissarissen/toezicht?', 'Is there a supervisory board?'), l('Nee', 'No')],
];
const bestuurders = [
  ['Bert de Haan', l('Voorzitter', 'Chairman')],
  ['Vincent van Geerestein', l('Penningmeester', 'Treasurer')],
  ['Dick Pieterman', l('Secretaris', 'Secretary')],
].map(([naam, functie]) => ({ naam, functie, beloning: l('Beloning beperkt tot onkostenvergoeding', 'Remuneration limited to expense allowance') }));
const contact: [string, string, string?][] = [
  [l('E-mailadres', 'Email address'), 'info@breadforthehungryministries.nl', 'mailto:info@breadforthehungryministries.nl'],
  [l('WWW adres', 'Website'), 'https://breadforthehungryministries.nl', 'https://breadforthehungryministries.nl'],
  [l('Contactpersoon', 'Contact person'), 'Vincent van Geerestein'],
  [l('IBAN rekeningnummer', 'IBAN account number'), 'NL11RABO0317228463'],
];
const publicaties = [
  ['2026', 'Hoofdlijnen beleidsplan', '2026-Beleidsplan-Bread-for-the-Hungry', '2026-Beleidsplan-Bread-for-the-Hungry-Ministries-1.pdf'],
  ['2025', 'Standaardformulier publicatieplicht', '2025-Standaard-Rapportage-Bread-for-the-Hungry', '2025-Standaard-Rapportage-Bread-for-the-Hungry-publicatie-1.3_printed.pdf'],
  ['2025', 'Actueel verslag activiteiten', '2025-Actueel-Verslag-Activiteiten-Bread-for-the-Hungry', '2025-Stichting-Bread-for-the-Hungry-Ministries-verslag.pdf'],
  ['2024', 'Standaardformulier publicatieplicht', '2024-Standaard-Rapportage-Bread-for-the-Hungry', '2024-Standaard-Rapportage-Bread-for-the-Hungry-publicatie-1.1.pdf'],
  ['2024', 'Actueel verslag activiteiten', '2024-Actueel-Verslag-Activiteiten-Bread-for-the-Hungry', '2024-Verslag-Bread-for-the-Hungry-Ministries.pdf'],
  ['2024', 'Hoofdlijnen beleidsplan', '2024-Beleidsplan-Bread-for-the-Hungry', '2024-Beleidsplan-Bread-for-the-Hungry-Ministries.pdf'],
];
const typeLabel: Record<string, string> = {
  'Hoofdlijnen beleidsplan': l('Hoofdlijnen beleidsplan', 'Outline of policy plan'),
  'Standaardformulier publicatieplicht': l('Standaardformulier publicatieplicht', 'Standard publication-duty form'),
  'Actueel verslag activiteiten': l('Actueel verslag activiteiten', 'Current report of activities'),
};
---

<Layout
  title={l('ANBI Profiel', 'ANBI profile')}
  seoTitle={l('ANBI Profiel | Stichting Bread for the Hungry Ministries', 'ANBI profile | Stichting Bread for the Hungry Ministries')}
  description={l(
    'ANBI-profiel van Stichting Bread for the Hungry Ministries (KvK 68179901, RSIN 857334591): doelstelling, bestuur, beleidsplannen en jaarverslagen.',
    'ANBI profile (Dutch public benefit organisation status) of Stichting Bread for the Hungry Ministries (KvK 68179901, RSIN 857334591): objectives, board, policy plans and annual reports.',
  )}
>
  <Hero title={l('ANBI Profiel', 'ANBI profile')} eyebrow={l('Over ons', 'About us')} image={hero} imageAlt={l('Gestapelde Bijbels voor de studenten', 'Stacked Bibles for the students')} position="50% 50%" />

  <div class="container-prose section space-y-14">
    <section aria-labelledby="algemeen">
      <h2 id="algemeen">{l('Algemene informatie', 'General information')}</h2>
      <dl class="rows mt-6">
        {algemeen.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <section aria-labelledby="activiteiten">
      <h2 id="activiteiten">{l('Activiteiten', 'Activities')}</h2>
      <dl class="rows mt-6">
        {activiteiten.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <section aria-labelledby="organisatie">
      <h2 id="organisatie">{l('Organisatie / Bestuurders', 'Organisation / Board members')}</h2>
      <dl class="rows mt-6">
        {organisatie.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <div class="table-wrap mt-6">
        <table>
          <thead><tr><th scope="col">{l('Naam', 'Name')}</th><th scope="col">{l('Titel / Functie', 'Title / Function')}</th><th scope="col">{l('Beloning', 'Remuneration')}</th></tr></thead>
          <tbody>
            {bestuurders.map((b) => <tr><th scope="row">{b.naam}</th><td>{b.functie}</td><td>{b.beloning}</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="contact-info">
      <h2 id="contact-info">{l('Contact informatie', 'Contact information')}</h2>
      <dl class="rows mt-6">
        {contact.map(([k, v, href]) => <div><dt>{k}</dt><dd>{href ? <a href={href}>{v}</a> : v}</dd></div>)}
      </dl>
    </section>

    <section aria-labelledby="publicatie">
      <h2 id="publicatie">{l('Publicatieplicht', 'Publication duty')}</h2>
      {lang === 'en' && <p class="mt-3 text-ink-soft">The linked documents are published in Dutch.</p>}
      <div class="table-wrap mt-6">
        <table>
          <thead><tr><th scope="col">{l('Jaar', 'Year')}</th><th scope="col">{l('Type document', 'Document type')}</th><th scope="col">Link</th></tr></thead>
          <tbody>
            {publicaties.map(([jaar, type, label, file]) => <tr><td>{jaar}</td><td>{typeLabel[type] ?? type}</td><td><a href={`/documenten/${file}`}>{label}</a></td></tr>)}
          </tbody>
        </table>
      </div>
    </section>
  </div>
  <CTA photos={false} />
</Layout>

<style>
  .rows > div {
    display: grid;
    gap: 0.15rem 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgb(43 58 74 / 0.12);
  }
  @media (min-width: 640px) {
    .rows > div {
      grid-template-columns: 16rem 1fr;
    }
  }
  dt {
    font-weight: 700;
  }
  dd {
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  a {
    color: var(--color-teal-700);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .table-wrap {
    overflow-x: auto;
    border-radius: 1rem;
    box-shadow: var(--shadow-card);
    background: #fff;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 34rem;
  }
  th,
  td {
    padding: 0.85rem 1.1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid rgb(43 58 74 / 0.1);
  }
  thead th {
    background: var(--color-teal-700);
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
</style>
