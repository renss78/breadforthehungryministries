---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import Hero from '../components/Hero.astro';
import Wave from '../components/Wave.astro';
import NewsCard from '../components/NewsCard.astro';
import { formatDate } from '../utils/format';
import { site } from '../data/site';
import { newsArticle } from '../data/schema';
import { getImage } from 'astro:assets';

// Nieuwsberichten staan op dezelfde URL's als op de oude WordPress-site (/<slug>/).
export const getStaticPaths = (async () => {
  const posts = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1], related: posts.filter((p) => p.id !== post.id).slice(0, 3) },
  }));
}) satisfies GetStaticPaths;

const { post, related } = Astro.props;
const { Content } = await render(post);
const { title, date, cover, coverAlt, excerpt } = post.data;
const ogImage = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const articleLd = newsArticle({ title, description: excerpt, path: `/${post.id}/`, image: new URL(ogImage.src, Astro.site).href, published: date });
---

<Layout
  title={title}
  seoTitle={`${title} | ${site.shortName}`}
  description={excerpt}
  image={cover}
  type="article"
  publishedTime={date}
  jsonLd={[articleLd]}
  crumbs={[{ name: 'Nieuws', path: '/nieuws/' }, { name: title, path: `/${post.id}/` }]}
>
  <Hero title={title} eyebrow={formatDate(date)} image={cover} imageAlt={coverAlt}>
    <Fragment slot="title"><span class="block text-[clamp(1.75rem,1.2rem+2.4vw,3rem)] leading-tight">{title}</span></Fragment>
    <a href="/nieuws/" class="link-arrow !border-gold-300 !text-white text-base">← Alle nieuws</a>
  </Hero>
  <article>
    <div class="container-prose prose section">
      <Content />
    </div>
  </article>

  <section class="relative mt-8 bg-sand" aria-labelledby="meer-nieuws">
    <Wave class="absolute inset-x-0 bottom-full -mb-px text-sand" flip />
    <div class="container-page section">
      <h2 id="meer-nieuws">Meer nieuws</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => <NewsCard post={p} />)}
      </div>
    </div>
  </section>
  <CTA photos={false} />
</Layout>
