---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import Hero from '../components/Hero.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import Wave from '../components/Wave.astro';
import NewsCard from '../components/NewsCard.astro';
import { formatDate } from '../utils/format';
import { getNews } from '../utils/news';
import { getLang, pick, postPath, route, ui } from '../i18n';
import { site } from '../data/site';
import { newsArticle } from '../data/schema';
import { getImage } from 'astro:assets';

// Nieuwsberichten staan op dezelfde URL's als op de oude WordPress-site (/<slug>/).
export const getStaticPaths = (async () => {
  const posts = await getNews('nl');
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1], related: posts.filter((p) => p.id !== post.id).slice(0, 3) },
  }));
}) satisfies GetStaticPaths;

const { post, related } = Astro.props;
const lang = getLang(Astro.url);
const l = pick(lang);
const { Content } = await render(post);
const { title, date, cover, coverAlt, excerpt, videos } = post.data;
const ogImage = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const articleLd = newsArticle({ title, description: excerpt, path: postPath(post.id, lang), lang, image: new URL(ogImage.src, Astro.site).href, published: date });
---

<Layout
  title={title}
  seoTitle={`${title} | ${site.shortName}`}
  description={excerpt}
  image={cover}
  type="article"
  publishedTime={date}
  jsonLd={[articleLd]}
  crumbs={[{ name: l('Nieuws', 'News'), path: route('news', lang) }, { name: title, path: postPath(post.id, lang) }]}
>
  <Hero title={title} eyebrow={formatDate(date, lang)} image={cover} imageAlt={coverAlt}>
    <Fragment slot="title"><span class="block text-[clamp(1.75rem,1.2rem+2.4vw,3rem)] leading-tight">{title}</span></Fragment>
    <a href={route('news', lang)} class="link-arrow !border-gold-300 !text-white text-base">← {l('Alle nieuws', 'All news')}</a>
  </Hero>
  {
    videos.length > 0 && (
      <section class="container-page pt-12 sm:pt-16" aria-label={l("Video's", 'Videos')}>
        <div class="mx-auto grid max-w-4xl gap-8">
          {videos.map((v, i) => (
            <YouTubeEmbed id={v.id} title={v.title} poster={v.poster} featured={i === 0} />
          ))}
        </div>
      </section>
    )
  }
  <article>
    <div class="container-prose prose section">
      <Content />
      <aside class="soft-card mt-12 p-6 sm:p-8" aria-labelledby="slot-sponsoring">
        <h2 id="slot-sponsoring" class="!mt-0">{ui[lang].ctaTitle}</h2>
        <p>{ui[lang].ctaText}</p>
        <a href={route('sponsorship', lang)} class="btn btn-clay mt-2 !text-white !no-underline">{l('Naar Sponsoring', 'Go to Sponsorship')}</a>
      </aside>
    </div>
  </article>

  <section class="relative mt-8 bg-sand" aria-labelledby="meer-nieuws">
    <Wave class="absolute inset-x-0 bottom-full -mb-px text-sand" flip />
    <div class="container-page section">
      <h2 id="meer-nieuws">{l('Meer nieuws', 'More news')}</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => <NewsCard post={p} />)}
      </div>
    </div>
  </section>
  <CTA photos={false} />
</Layout>
