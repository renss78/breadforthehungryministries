---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import NewsCard from '../components/NewsCard.astro';
import { formatDate } from '../utils/format';

// Nieuwsberichten staan op dezelfde URL's als op de oude WordPress-site (/<slug>/).
export const getStaticPaths = (async () => {
  const posts = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1], related: posts.filter((p) => p.id !== post.id).slice(0, 3) },
  }));
}) satisfies GetStaticPaths;

const { post, related } = Astro.props;
const { Content } = await render(post);
const { title, date, cover, coverAlt, excerpt } = post.data;
---

<Layout title={title} description={excerpt} image={cover} type="article" publishedTime={date}>
  <article>
    <header class="bg-sand">
      <div class="container-prose pb-10 pt-12 sm:pt-16">
        <a href="/nieuws/" class="link-arrow text-sm">← Alle nieuws</a>
        <time datetime={date.toISOString()} class="mt-6 block text-sm font-bold uppercase tracking-[0.14em] text-teal-700">{formatDate(date)}</time>
        <h1 class="mt-3 !text-[clamp(2rem,1.4rem+2.6vw,3.25rem)]">{title}</h1>
      </div>
    </header>
    <div class="container-page -mt-0 pt-8">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[640, 1024, 1400]}
        sizes="(min-width: 1152px) 72rem, 100vw"
        loading="eager"
        fetchpriority="high"
        class="mx-auto max-h-[34rem] w-full max-w-4xl rounded-3xl object-cover shadow-card"
      />
    </div>
    <div class="container-prose prose section">
      <Content />
    </div>
  </article>

  <section class="bg-sand" aria-labelledby="meer-nieuws">
    <div class="container-page section">
      <h2 id="meer-nieuws">Meer nieuws</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => <NewsCard post={p} />)}
      </div>
    </div>
  </section>
  <CTA photos={false} />
</Layout>
