---
import type { GetStaticPaths } from 'astro';
import NewsPost from '../[slug].astro';
import { getNews } from '../../utils/news';
import { nlIdOfEn } from '../../i18n';

// Engelse nieuwsberichten staan op /en/<slug>/; de koppeling met de Nederlandse slug staat in src/i18n/index.ts.
export const getStaticPaths = (async () => {
  const posts = await getNews('en');
  return posts.map((post, i) => {
    nlIdOfEn(post.id); // faalt de build als de slug niet gekoppeld is
    return {
      params: { slug: post.id },
      props: { post, newer: posts[i - 1], older: posts[i + 1], related: posts.filter((p) => p.id !== post.id).slice(0, 3) },
    };
  });
}) satisfies GetStaticPaths;

const props = Astro.props;
---

<NewsPost {...props} />
