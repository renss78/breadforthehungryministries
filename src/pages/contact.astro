---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';
import { getLang, pick } from '../i18n';
import hero from '../assets/images/oeganda-2026-sept-04.jpeg';

const lang = getLang(Astro.url);
const l = pick(lang);

// Vooringevuld WhatsApp-bericht (wa.me); bezoekers kunnen de tekst nog aanpassen voor het verzenden.
const whatsappText = l(
  'Hallo, ik kom via de website van Bread for the Hungry Ministries. Ik heb een vraag over jullie werk in Oeganda en Kenia.',
  'Hello, I am contacting you via the Bread for the Hungry Ministries website. I have a question about your work in Uganda and Kenya.',
);
const whatsappUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(whatsappText)}`;
---

<Layout
  title="Contact"
  seoTitle="Contact | Bread for the Hungry Ministries"
  description={l(
    'Neem contact op met Bread for the Hungry Ministries via het contactformulier, e-mail (info@breadforthehungryministries.nl) of telefoon.',
    'Get in touch with Bread for the Hungry Ministries via the contact form, email (info@breadforthehungryministries.nl) or phone.',
  )}
>
  <Hero title="Contact" eyebrow={l('Neem contact op', 'Get in touch')} image={hero} imageAlt={l('Een gezelschap aan tafel in Oeganda', 'A group around a table in Uganda')} position="50% 45%" />

  <div class="container-page section grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
    <!-- Verstuurt via functions/api/contact.ts (Resend); het veld `lang` bepaalt de taal van het antwoord. -->
    <form action="/api/contact" method="post" class="grid gap-5" aria-labelledby="form-titel">
      <h2 id="form-titel" class="sr-only">{l('Contactformulier', 'Contact form')}</h2>
      <input type="hidden" name="lang" value={lang} />
      <label class="field">
        <span>{l('Naam', 'Name')}</span>
        <input type="text" name="naam" autocomplete="name" maxlength="400" required />
      </label>
      <label class="field">
        <span>{l('Email', 'Email')}</span>
        <input type="email" name="email" autocomplete="email" maxlength="400" required />
      </label>
      <label class="field">
        <span>{l('Onderwerp', 'Subject')}</span>
        <input type="text" name="onderwerp" maxlength="400" required />
      </label>
      <label class="field">
        <span>{l('Bericht', 'Message')}</span>
        <textarea name="bericht" rows="8" maxlength="2000" required></textarea>
      </label>
      <!-- Honeypot tegen spam: echte bezoekers zien en vullen dit veld niet in. -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label>{l('Laat dit veld leeg', 'Leave this field empty')} <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <div><button type="submit" class="btn btn-teal">{l('Verzenden', 'Send')}</button></div>
    </form>

    <aside aria-labelledby="adres-titel" class="self-start rise rounded-[2rem] bg-sand p-7 sm:p-9">
      <h2 id="adres-titel" class="!text-2xl">{l('Adresgegevens', 'Contact details')}</h2>
      <dl class="mt-6 space-y-5">
        <div>
          <dt class="eyebrow">Email</dt>
          <dd class="mt-1 break-all text-lg"><a href={`mailto:${site.email}`} class="font-semibold text-teal-700">{site.email}</a></dd>
        </div>
        <div>
          <dt class="eyebrow">{l('Telefoon', 'Phone')}</dt>
          <dd class="mt-1 text-lg"><a href={`tel:${site.phone}`} class="font-semibold text-teal-700">{site.phone}</a></dd>
        </div>
      </dl>
      <a href={whatsappUrl} target="_blank" rel="noopener" class="btn btn-wa mt-7">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
        {l('Stuur een WhatsApp-bericht', 'Send a WhatsApp message')}
      </a>
    </aside>
  </div>
</Layout>

<style>
  .btn-wa {
    background: #107c41;
    color: #fff;
    box-shadow: 0 8px 20px -8px rgb(16 124 65 / 0.6);
  }
  .btn-wa:hover {
    background: #0b5f31;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field > span {
    font-weight: 700;
  }
  input:not([type='submit']),
  textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 2px solid rgb(43 58 74 / 0.25);
    border-radius: 0.75rem;
    background: #fff;
    font: inherit;
    color: var(--color-ink);
    transition: border-color 0.2s;
  }
  input:hover,
  textarea:hover {
    border-color: var(--color-ink-soft);
  }
  input:focus,
  textarea:focus {
    outline: 3px solid var(--color-teal-500);
    outline-offset: 1px;
    border-color: var(--color-teal-700);
  }
</style>
