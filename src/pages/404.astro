---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina niet gevonden" noindex>
  <section class="container-prose section text-center">
    <p class="eyebrow">Foutmelding 404</p>
    <h1 class="mt-4">Deze pagina bestaat niet (meer)</h1>
    <p class="mt-6 text-lg">De pagina die u zoekt is verplaatst of bestaat niet. Probeer een van onderstaande pagina's.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-teal">Naar de homepage</a>
      <a href="/nieuws/" class="btn btn-light !border-ink/20">Nieuws</a>
    </div>
  </section>
</Layout>
