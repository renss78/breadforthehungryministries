/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.youtube-nocookie.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Gehashte build-assets (JS, CSS, afbeeldingen, lettertypen): voor altijd cachen
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Statische media die zelden wijzigt
/media/*
  Cache-Control: public, max-age=604800
/documenten/*
  Cache-Control: public, max-age=86400

# Favicons
/favicon.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# De API-functie nooit cachen of laten indexeren
/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex
